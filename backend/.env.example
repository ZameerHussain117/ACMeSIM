# Copy this file to .env and fill in real values. Never commit .env itself.

# Server
PORT=5000
NODE_ENV=development

# MongoDB — local instance or a free MongoDB Atlas cluster
MONGO_URI=mongodb://localhost:27017/esim-app

# GOOGLE OAUTH2 CREDENTIALS
CLIENT_ID=
PROJECT_ID="
AUTH_URI=
TOKEN_URI=
AUTH_PROVIDER_X509_CERT_URL=


# Auth
JWT_SECRET=replace-with-a-long-random-string
JWT_EXPIRES_IN=7d

# Stripe (test mode keys — starts with sk_test_)
STRIPE_SECRET_KEY=sk_test_replace_me

# eSIMgo — not yet available. Using mocked data in /mocks until real access is granted.
ESIMGO_API_KEY=
ESIMGO_BASE_URL=

# payment gateway credentials
CLIENT_ID=
SECRET_KEY=
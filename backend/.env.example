# Copy this file to .env and fill in real values. Never commit .env itself.

# Server
PORT=5000
NODE_ENV=development

# MongoDB — local instance or a free MongoDB Atlas cluster
MONGO_URI=mongodb://localhost:27017/esim-app

# Auth
JWT_SECRET=replace-with-a-long-random-string
JWT_EXPIRES_IN=7d

# Stripe (test mode keys — starts with sk_test_)
STRIPE_SECRET_KEY=sk_test_replace_me

# eSIMgo — not yet available. Using mocked data in /mocks until real access is granted.
ESIMGO_API_KEY=not-yet-available-using-mock-data
ESIMGO_BASE_URL=https://api.esimgo.com/v2
